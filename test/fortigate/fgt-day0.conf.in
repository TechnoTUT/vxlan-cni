config system global
    set hostname "vxt-fgt"
    set admintimeout 480
end
config system admin
    edit "admin"
        set password "@ADMIN_PASSWORD@"
    next
end
config system interface
    edit "port1"
        set mode static
        set ip @FGT_IP@ 255.255.255.0
        set allowaccess ping https ssh http
    next
    edit "port2"
        set mode static
    next
    edit "port3"
        set mode dhcp
        set allowaccess ping
    next
    edit "VLAN@VLAN@"
        set vdom "root"
        set interface "port2"
        set vlanid @VLAN@
    next
end
config system vxlan
    edit "vxlan@VLAN@"
        set interface "port1"
        set vni @VLAN@
        set remote-ip "@NODE1_IP@" "@NODE2_IP@"
    next
end
config system switch-interface
    edit "sw@VLAN@"
        set vdom "root"
        set member "VLAN@VLAN@" "vxlan@VLAN@"
        set intra-switch-policy implicit
    next
end
config system interface
    edit "sw@VLAN@"
        set ip @VLAN_GW@ 255.255.255.0
        set allowaccess ping
    next
end
config system dhcp server
    edit 1
        set interface "sw@VLAN@"
        set default-gateway @VLAN_GW@
        set netmask 255.255.255.0
        set dns-service default
        set vci-match disable
        config ip-range
            edit 1
                set start-ip 10.20.0.100
                set end-ip 10.20.0.199
            next
        end
    next
end
